# KyokkouPT frontend · production example
#
# Copy to .env on the server. Do not include development-only values.

FRONTEND_HOST=0.0.0.0
# Public origin used by browser-facing APIs and links through Nginx.
API_ORIGIN=https://pt.example.com
# Internal backend origin used by server-side requests and the tracker proxy.
BACKEND_API_ORIGIN=http://127.0.0.1:31001
# Only when using the two-layer Nginx deployment:
# BACKEND_SECRET=REPLACE_WITH_SHARED_SECRET
