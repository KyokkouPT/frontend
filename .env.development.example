# KyokkouPT frontend · development example
#
# Copy to .env for local development. `.env` is gitignored.

FRONTEND_HOST=127.0.0.1
# Next.js server-side proxy target for /api, /rss, /t/*/download.
API_ORIGIN=http://127.0.0.1:31001
# server.mjs proxy target for /announce and /scrape.
BACKEND_API_ORIGIN=http://127.0.0.1:31001
