# KyokkouPT frontend environment
#
# 复制为 .env.local（推荐，本机覆盖）或 .env；两者都不会提交。
# Next 加载顺序：.env.local > .env。

# 浏览器同源路径 /api、/rss、/t/*/download 由 Next 反代到这里（构建时读取，改了要重新 build）
API_ORIGIN=http://127.0.0.1:31001

# server.mjs 转发 /announce、/scrape 到这里（运行时读取）
BACKEND_API_ORIGIN=http://127.0.0.1:31001

# 仅双层 Nginx 部署需要：作为 X-Kyou-Secret 发给后端 Nginx
# 单层 Nginx + server.mjs 不需要；不要加 NEXT_PUBLIC_ 前缀
# BACKEND_SECRET=
